# ── Telegram (обязательно) ─────────────────────────────────────────────
# Токен бота от @BotFather. Хранится ТОЛЬКО на сервере, никогда не попадает во фронтенд.
TELEGRAM_BOT_TOKEN=
# ID чата, куда приходят заявки: ваш личный ID, группа (начинается с -100…) или канал.
TELEGRAM_CHAT_ID=

# ── Надёжное хранилище заявок (рекомендуется для Vercel) ──────────────
# Если Telegram недоступен, заявка сохраняется в Upstash Redis и досылается позже.
# Бесплатный план: https://upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Свой сервер (VPS) ─────────────────────────────────────────────────
# Папка для резервного хранения заявок, если Upstash не настроен (только для своего сервера).
LEADS_DIR=./.data/leads
PORT=3000

# ── Досылка отложенных заявок ─────────────────────────────────────────
# Секрет для /api/retry-leads (Vercel Cron передаёт его автоматически как Bearer).
CRON_SECRET=
